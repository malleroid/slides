{
  "name": "slidev-theme-dracula",
  "version": "0.0.0",
  "type": "module",
  "description": "Dracula color scheme theme",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "license": "MIT",
  "files": [
    "layouts",
    "components",
    "styles",
    "setup",
    "layoutHelper.ts"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev example.md --open",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@slidev/types": "^52.11.5",
    "codemirror-theme-vars": "^0.1.2",
    "prism-theme-vars": "^0.2.4"
  },
  "devDependencies": {
    "@slidev/cli": "52.18.0"
  },
  "slidev": {
    "colorSchema": "dark",
    "highlighter": "shiki",
    "defaults": {
      "fonts": {
        "sans": "Nunito Sans",
        "mono": "JetBrains Mono"
      }
    }
  }
}
