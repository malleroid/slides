{
  "name": "slidev-theme-paiza",
  "version": "0.0.0",
  "type": "module",
  "description": "Corporate theme for paiza presentations",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "license": "MIT",
  "files": [
    "layouts",
    "components",
    "styles",
    "setup",
    "uno.config.ts"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev example.md --open",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@iconify-json/twemoji": "^1.2.5",
    "@slidev/types": "^52.18.1"
  },
  "devDependencies": {
    "@slidev/cli": "52.18.1"
  },
  "slidev": {
    "colorSchema": "both",
    "highlighter": "shiki",
    "defaults": {
      "fonts": {
        "sans": "M PLUS 2",
        "mono": "Fira Code"
      }
    }
  }
}
