{
  "name": "slidev-theme-cobalt",
  "version": "0.0.0",
  "type": "module",
  "description": "A Slidev theme featuring a deep cobalt blue color scheme with framed layouts",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "license": "MIT",
  "files": [
    "layouts",
    "components",
    "styles",
    "setup"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev example.md --open",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@slidev/types": "^52.18.1"
  },
  "devDependencies": {
    "@slidev/cli": "52.18.0"
  },
  "slidev": {
    "colorSchema": "both",
    "defaults": {
      "fonts": {
        "sans": "Inter",
        "mono": "Fira Code"
      }
    }
  }
}
